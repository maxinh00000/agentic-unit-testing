{
  "base_url": "https://openrouter.ai/api/v1",
  "model": "google/gemma-4-31b-it:free",
  "fallback_models": [
    "google/gemma-4-26b-a4b-it:free",
    "nvidia/nemotron-3-super-120b-a12b:free"
  ],
  "top_p": 1.0,
  "seed": 42,
  "disable_reasoning": true,
  "request_timeout_s": 180,
  "max_retries": 6,
  "min_interval_s": 3.5,
  "code_gen": {
    "temperature": 0.2,
    "max_tokens": 1024
  },
  "test_gen": {
    "temperature": 0.2,
    "max_tokens": 3000
  },
  "triage": {
    "temperature": 0.0,
    "max_tokens": 800
  },
  "criterion": "branch",
  "target_pct": 100.0,
  "max_test_iterations": 3,
  "max_code_attempts": 2,
  "max_test_format_attempts": 3,
  "pytest_timeout_s": 60,
  "dataset": "mbpp-sanitized",
  "split": "test"
}