# Copy this file to .env and fill in your key.  Never commit .env.
OPENROUTER_API_KEY=sk-or-v1-...

# Optional overrides
# LLM_MODEL=google/gemma-4-31b-it:free
# LLM_FALLBACK_MODELS=google/gemma-4-26b-a4b-it:free,nvidia/nemotron-3-super-120b-a12b:free   # empty = no fallback
# LLM_BASE_URL=https://openrouter.ai/api/v1      # any OpenAI-compatible endpoint (e.g. KiloAI)
# LLM_DISABLE_REASONING=true                      # keep true: assignment forbids chain-of-thought
# LLM_MIN_INTERVAL_S=3.5                          # seconds between requests (free tier ~20 req/min)
